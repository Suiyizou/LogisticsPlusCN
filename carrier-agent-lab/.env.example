# pi SDK model. If omitted, the first configured vision-capable model is used.
# PI_PROVIDER=siliconflow
# PI_MODEL=Qwen/Qwen3-VL-8B-Instruct

# HTTP server. Loopback is the safe local default; containers set 0.0.0.0.
TRACKING_HOST=127.0.0.1
TRACKING_PORT=4317

# One browser/Agent run at a time, with at most five waiting requests.
TRACKING_MAX_CONCURRENCY=1
TRACKING_QUEUE_LIMIT=5

# Run-scoped screenshot retention. Values are clamped to 1-168 hours (7 days).
TRACKING_ARTIFACT_TTL_HOURS=24

# Local previews may use a visible browser. Secure/container deployments should
# set HEADLESS=true and ALLOW_HEADED=false so API callers cannot override it.
TRACKING_BROWSER_HEADLESS=false
TRACKING_BROWSER_ALLOW_HEADED=true
TRACKING_BROWSER_CHANNEL=chrome
TRACKING_BROWSER_TIMEOUT_MS=45000

# Known official sites are always allowed. Public HTTPS navigation lets the
# agent handle a caller-supplied carrier URL while private/local hosts stay blocked.
TRACKING_NAVIGATION_POLICY=public-https
TRACKING_REQUIRE_VISION=true

# Enables the isolated LABBOOKING123 success demo. Keep disabled outside local preview environments.
TRACKING_ENABLE_DEMO=false
