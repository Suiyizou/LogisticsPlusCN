FRONTEND_PORT=80
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cargo_planner
MYSQL_USER=cargo_planner
MYSQL_PASSWORD=cargo_planner_pwd
MYSQL_ROOT_PASSWORD=cargo_root_pwd
APP_DEVICE_LIMIT_PER_USER=5
APP_CUSTOMER_SESSION_HOURS=24
# First start or one-time legacy-admin migration: set all four values explicitly.
# The password must be 12-128 characters, meet all complexity requirements, and
# must not contain the username. After one successful start, disable bootstrap
# and remove the password from .env.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
# Versioned DB migrations (Flyway). Set false only for a controlled drill/rollback.
SPRING_FLYWAY_ENABLED=true
SPRING_AI_CHAT_MODEL=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_MODEL=deepseek-v4-flash
EXCEL_AGENT_BATCH_CONCURRENCY=3
APP_WORKSPACE_FILE_RETENTION=14d
APP_WORKSPACE_FILE_CLEANUP_INTERVAL_MS=3600000
APP_WORKSPACE_FILE_MAX_SIZE_BYTES=83886080
APP_ANNOUNCEMENT_IMAGE_MAX_SIZE_BYTES=10485760
# Cloud deployments query the desktop Chrome service; the tracking image only serves static files.
# Also selects the frontend Vite build profile in production/staging Compose.
# Rebuild frontend when changing this mode; a runtime environment change is insufficient.
# The isolated dev-preview override pins both sides to LEGACY for its preserved backend.
APP_TRACKING_ADAPTER_MODE=LOCAL_QUEUE
APP_TRACKING_LOCAL_BASE_URL=http://host.docker.internal:18791
# Leave empty while desktop auth is disabled. When enabling auth, set the same
# non-empty TRACK_TOKEN (or higher-priority TOKEN) locally and restart both services.
APP_TRACKING_LOCAL_TOKEN=
APP_TRACKING_LOCAL_JOB_TIMEOUT=7m
APP_TRACKING_LOCAL_POLL_INTERVAL=2s
APP_TRACKING_LOCAL_REQUEST_TIMEOUT=15s
APP_TRACKING_CACHE_TTL=15m
APP_TRACKING_CONNECT_TIMEOUT=5s
# Active COSCO/CMA shipments are refreshed once per day. HH:mm uses the configured IANA time zone.
APP_TRACKING_AUTO_REFRESH_ENABLED=false
APP_TRACKING_AUTO_REFRESH_DAILY_TIME=00:00
APP_TRACKING_AUTO_REFRESH_TIME_ZONE=Asia/Shanghai
APP_TRACKING_AUTO_REFRESH_CLAIM_BATCH_SIZE=10
APP_TRACKING_SUPPLEMENTAL_RETRY_ENABLED=true
APP_TRACKING_SUPPLEMENTAL_RETRY_MIN_DELAY=15m
APP_TRACKING_SUPPLEMENTAL_RETRY_MAX_DELAY=30m
# After this many consecutive supplemental failures, preserve its sources and yield to daily FULL.
APP_TRACKING_SUPPLEMENTAL_FAILURE_LIMIT_BEFORE_FULL=3
# Carrier login sessions remain in the local Chrome profile.
SHIPMENT_FILE_HOST_PATH=./data/shipment-files
APP_SHIPMENT_FILE_MAX_SIZE_BYTES=83886080
APP_SHIPMENT_FILE_MAX_FILES_PER_SHIPMENT=200
APP_SHIPMENT_FILE_MAX_BYTES_PER_SHIPMENT=2147483648
APP_SHIPMENT_FILE_MAX_BYTES_PER_CUSTOMER=5368709120
APP_SHIPMENT_FILE_MIN_FREE_SPACE_BYTES=1073741824
APP_SHIPMENT_FILE_ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv,doc,docx,jpg,jpeg,png,txt,md,markdown
VITE_TRACKING_WORKBENCH_URL=/tracking/
VITE_TRACKING_DEV_TARGET=http://127.0.0.1:3000
