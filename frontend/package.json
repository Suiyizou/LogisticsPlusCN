{
  "name": "cargo-container-planner-frontend",
  "version": "0.2.0",
  "description": "货代装箱体积规划系统客户端",
  "author": "Suiyizou",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177",
    "build": "npm run i18n:scan && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:sfc && npm run typecheck:ports && node scripts/check-api-contract-types.mjs",
    "i18n:scan": "node scripts/check-i18n-hardcoded.js",
    "i18n:baseline": "node scripts/check-i18n-hardcoded.js --write-baseline",
    "test:loaded-pallet-import": "node scripts/check-loaded-pallet-import.js",
    "test:irregular-pallet-import": "node scripts/check-irregular-pallet-import.js",
    "test:packing-single-layer-row-fill": "node scripts/check-packing-single-layer-row-fill.js",
    "test:packing-level-first": "node scripts/check-packing-level-first.js",
    "test:packing-pallet-gap": "node scripts/check-packing-pallet-gap.js",
    "test:packing-large-workload": "node scripts/check-packing-large-workload.js",
    "test:packing-report": "node scripts/check-report-label-layout.js && node scripts/check-remaining-space.js",
    "test:packing": "npm run test:packing-level-first && npm run test:packing-single-layer-row-fill && npm run test:packing-pallet-gap && npm run test:packing-large-workload",
    "test:container-reference-data": "node scripts/check-container-reference-data.js",
    "test:customer-batch-import": "node scripts/check-customer-batch-import.js",
    "test:shipment-detail": "node --test test/shipment-detail.test.mjs",
    "test:shipment-batch-import": "node scripts/check-shipment-batch-import.js",
    "test:design-system": "node scripts/check-design-system.js",
    "desktop:preview": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis --x64",
    "test:features": "node --test test/*.test.mjs",
    "typecheck:sfc": "vue-tsc -p tsconfig.vue.json --noEmit && node scripts/check-sfc-typecheck.mjs",
    "typecheck:ports": "node scripts/check-module-port-types.mjs",
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "echarts": "^5.6.0",
    "element-plus": "^2.14.2",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.4.299",
    "three": "^0.180.0",
    "vite": "^5.4.19",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "3.3.13"
  },
  "build": {
    "appId": "com.cargo.container.planner",
    "productName": "货代装箱体积规划系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "货代装箱体积规划系统"
    }
  }
}
